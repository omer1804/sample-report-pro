{
  "name": "Report",
  "type": "object",
  "properties": {
    "report_name": {
      "type": "string",
      "description": "Display name of the report"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "standard",
        "curing"
      ],
      "default": "standard",
      "description": "Type of report workflow"
    },
    "customer_name": {
      "type": "string",
      "description": "Name of the customer"
    },
    "task_number": {
      "type": "string",
      "description": "Task number or reference ID"
    },
    "date_completed": {
      "type": "string",
      "format": "date",
      "description": "Date the report was completed"
    },
    "application_engineer": {
      "type": "string",
      "description": "Name of the application engineer"
    },
    "requestor": {
      "type": "string",
      "description": "Person who requested the report"
    },
    "machine_model": {
      "type": "string",
      "description": "Legacy machine model value"
    },
    "ink_version": {
      "type": "string",
      "description": "Legacy ink version value"
    },
    "setup": {
      "type": "string",
      "description": "Legacy setup value"
    },
    "resolution": {
      "type": "string",
      "description": "Legacy resolution value"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed"
      ],
      "default": "draft",
      "description": "Status of the report"
    },
    "fabrics": {
      "type": "array",
      "description": "Array of sample details",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Fabric number"
          },
          "fabric_details": {
            "type": "string",
            "description": "Additional fabric details"
          },
          "material_description": {
            "type": "string"
          },
          "working_point": {
            "type": "string",
            "description": "Legacy working point value"
          },
          "working_point_q": {
            "type": "string",
            "description": "Q working point percentage"
          },
          "working_point_qu": {
            "type": "string",
            "description": "QU working point percentage"
          },
          "working_point_w": {
            "type": "string",
            "description": "W working point percentage"
          },
          "working_point_qw": {
            "type": "string",
            "description": "QW working point percentage"
          },
          "working_point_custom": {
            "type": "array",
            "description": "Custom working point letter and percentage values",
            "items": {
              "type": "object",
              "properties": {
                "letter": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "machine_model": {
            "type": "string",
            "description": "Machine model used for this sample"
          },
          "ink_version": {
            "type": "string",
            "description": "Ink version used for this sample"
          },
          "setup": {
            "type": "string",
            "description": "Setup details for this sample"
          },
          "resolution": {
            "type": "string",
            "description": "Resolution settings for this sample"
          },
          "ink_consumption_unit": {
            "type": "string",
            "enum": [
              "ml",
              "ml/m\u00b2"
            ],
            "default": "ml/m\u00b2",
            "description": "Ink consumption unit"
          },
          "ink_consumption_cyan": {
            "type": "string",
            "description": "Cyan ink consumption"
          },
          "ink_consumption_magenta": {
            "type": "string",
            "description": "Magenta ink consumption"
          },
          "ink_consumption_yellow": {
            "type": "string",
            "description": "Yellow ink consumption"
          },
          "ink_consumption_black": {
            "type": "string",
            "description": "Black ink consumption"
          },
          "ink_consumption_neon": {
            "type": "string",
            "description": "Legacy neon ink consumption"
          },
          "ink_consumption_neon_pink": {
            "type": "string",
            "description": "Neon pink ink consumption"
          },
          "ink_consumption_neon_yellow": {
            "type": "string",
            "description": "Neon yellow ink consumption"
          },
          "ink_consumption_red": {
            "type": "string",
            "description": "Red ink consumption"
          },
          "ink_consumption_green": {
            "type": "string",
            "description": "Green ink consumption"
          },
          "ink_consumption_fof_color": {
            "type": "string",
            "description": "Fof Color ink consumption"
          },
          "ink_consumption_white": {
            "type": "string",
            "description": "White ink consumption"
          },
          "ink_consumption_fof_white": {
            "type": "string",
            "description": "U10 White ink consumption"
          },
          "ink_consumption_u10": {
            "type": "string",
            "description": "U10 ink consumption"
          },
          "ink_consumption_fof_white_top_coat": {
            "type": "string",
            "description": "FoF White Top Coat ink consumption"
          },
          "ink_consumption_total": {
            "type": "string",
            "description": "Total ink consumption"
          },
          "curing_time_min": {
            "type": "number",
            "description": "Curing time in minutes"
          },
          "curing_temp_celsius": {
            "type": "number",
            "description": "Curing temperature in Celsius"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_captions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Titles for sample images"
          }
        }
      }
    },
    "curing_report": {
      "type": "object",
      "description": "Curing test report table data",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fabric_name": {
                "type": "string"
              },
              "material": {
                "type": "string"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string",
                      "enum": [
                        "",
                        "pass",
                        "fail"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "attachments": {
      "type": "array",
      "description": "Report file attachments included in ZIP exports",
      "items": {
        "type": "string"
      }
    },
    "general_images": {
      "type": "array",
      "description": "General report images shown in the PDF report",
      "items": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "application_note_images": {
      "type": "array",
      "description": "Images attached to application notes and shown in the PDF report",
      "items": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "conclusion": {
      "type": "string",
      "description": "Application notes"
    },
    "last_saved": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last save"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Whether this report is hidden after deletion"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this report was deleted"
    }
  },
  "required": [
    "date_completed",
    "application_engineer"
  ]
}